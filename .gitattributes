# Windows batch files must use CRLF: LF-only .bat/.cmd files hit subtle bugs in
# labels, `goto` and multi-line blocks. Force CRLF for them on every clone,
# whatever the machine's core.autocrlf setting is.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Everything else stays LF in the repository.
* text=auto eol=lf

# The encrypted seed database is ciphertext, not text. Marking it binary stops
# Git from applying line-ending conversion or trying to diff it as text, either
# of which would corrupt the file for anyone cloning the repository.
*.enc binary
*.db binary
