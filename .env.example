# ============================================================================
#  Environment template for local install.
#
#  1-INSTALL.BAT copies this file to ".env.local" (which is git-ignored) and
#  fills in the machine-specific and secret values. You never edit this file
#  on a real machine — edit .env.local, and re-run 1-INSTALL.BAT if it is
#  missing.
# ============================================================================

# --- Backend (local PC) -----------------------------------------------------
PORT=5000
HOST=127.0.0.1

# Only these frontends may call the API with cookies (see server/src/security.ts).
# Keep http://localhost:3000 first for a plain local run.
ALLOWED_ORIGINS=http://localhost:3000

SESSION_COOKIE_NAME=sid
SESSION_TTL_HOURS=24
SESSION_CLEANUP_MINUTES=60

# Login brute-force protection (these stay ON even with the captcha disabled).
LOGIN_MAX_FAILURES_PER_IP=10
LOGIN_MAX_FAILURES_PER_USER=6
LOGIN_LOCK_WINDOW_MINUTES=15

LOG_RETENTION_DAYS=30
MAX_CONCURRENT_SEARCHES=1

# First admin account, created automatically on the very first boot when the
# database has no users yet. Rules: 10+ chars, upper, lower, digit, special.
# 1-INSTALL.BAT fills both of these with the values it prints on screen.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Frontend ---------------------------------------------------------------
# Next.js inlines NEXT_PUBLIC_* at startup, so both servers must be restarted
# after changing anything in this section.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# --- Captcha (Cloudflare Turnstile) ----------------------------------------
# Left empty on purpose: the widget does not load and the server skips
# siteverify. Login is still protected by the LOGIN_MAX_FAILURES_* locks above,
# the honeypot and the auth rate limiters. Paste a real key pair back here and
# restart both servers to turn it on again.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Browser used for extraction -------------------------------------------
# Real Google Chrome is strongly preferred over Playwright's bundled Chromium:
# it has a far weaker automation fingerprint, so Google is less likely to block
# extraction. 1-INSTALL.BAT points this at the <repo>\playwright-browsers folder
# and 2-START.BAT re-exports it before launching, so it works no matter which
# drive the repo sits on.
PLAYWRIGHT_BROWSERS_PATH=

# --- Backups ----------------------------------------------------------------
# Where the in-app backup / restore buttons write. Relative to the repo root.
BACKUP_ROOT=./backups

# NOTE: never put a Vercel token or any other secret in this file.
# ".env.local" is git-ignored on purpose — only this template is committed.
