# --- Backend (local laptop, runs behind Cloudflare tunnel) ---
# Port + bind host for the Express server
PORT=5000
# Bind to loopback only — cloudflared tunnel is the single entry point.
HOST=127.0.0.1

# Frontend origin(s) allowed to call the API (comma-separated). Add your Vercel URL.
ALLOWED_ORIGINS=http://localhost:3000,__YOUR_VERCEL_URL__

# Session cookie + expiry
SESSION_COOKIE_NAME=sid
SESSION_TTL_HOURS=24
SESSION_CLEANUP_MINUTES=60

# Bootstrap admin — ONLY used when no users exist yet. Then use: npm run create-admin
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your-long-password

# Brute-force / abuse protection
LOGIN_MAX_FAILURES_PER_IP=10
LOGIN_MAX_FAILURES_PER_USER=6
LOGIN_LOCK_WINDOW_MINUTES=15

# Log retention (days)
LOG_RETENTION_DAYS=30

# --- Frontend (Vercel) ---
# Backend base URL as seen from the browser = your Cloudflare tunnel URL.
# Use a FIXED named tunnel so this never changes between restarts.
NEXT_PUBLIC_API_BASE_URL=https://__YOUR_TUNNEL_URL__

# Playwright browsers location (C: is full, so browsers live on D:)
PLAYWRIGHT_BROWSERS_PATH=D:\Office work\yawar leads\playwright-browsers
