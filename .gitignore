# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth -- covers /node_modules and server/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local backend runtime data + DB
server/data/
.runtime/
backups/

# Playwright browsers — downloaded per-machine by 1-INSTALL.BAT
playwright-browsers/

# Seed database for fresh installs. Intentionally NOT committed: crm.db holds
# real business leads and bcrypt password hashes, and the GitHub repository this
# is pushed to is public. Copy seed/crm.db into the clone by hand (or unpack the
# encrypted bundle) before running 1-INSTALL.BAT -- it is only read when
# server\data\crm.db does not exist yet.
seed/*
!seed/README.md

# local dev logs
dev-server.log
dev-server-err.log
logs/

# portable binaries (downloaded per-machine, not source)
tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
