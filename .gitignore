# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any depth -- covers /node_modules and server/node_modules)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local backend runtime data + DB
server/data/
.runtime/
backups/

# Playwright browsers — downloaded per-machine by 1-INSTALL.BAT
playwright-browsers/

# Seed database for fresh installs. The plaintext crm.db holds real business
# leads and bcrypt password hashes, and the GitHub repository this is pushed to
# is public, so the plaintext file is never committed. What is committed is
# seed/crm.db.enc, sealed with AES-256-GCM under a scrypt-derived key:
# unreadable to anyone who finds the repository without the passphrase, and
# 1-INSTALL.BAT asks for that passphrase and decrypts it into server\data\crm.db
# only when no database exists there yet.
seed/*
!seed/README.md
!seed/crm.db.enc

# local dev logs
dev-server.log
dev-server-err.log
logs/

# portable binaries (downloaded per-machine, not source)
tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
